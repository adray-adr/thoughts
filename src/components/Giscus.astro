---
// Comments powered by Giscus (https://giscus.app), backed by GitHub Discussions.
// Setup: 1) enable Discussions on your GitHub repo for this site
//        2) go to https://giscus.app, fill in your repo, and copy the values below
//        3) replace every REPLACE_ME value with what giscus.app gives you
---
<section id="comments" style="margin-top: 56px;">
  <script
    src="https://giscus.app/client.js"
    data-repo="REPLACE_ME/REPLACE_ME"
    data-repo-id="REPLACE_ME"
    data-category="Comments"
    data-category-id="REPLACE_ME"
    data-mapping="pathname"
    data-strict="0"
    data-reactions-enabled="1"
    data-emit-metadata="0"
    data-input-position="bottom"
    data-theme="light"
    data-lang="en"
    crossorigin="anonymous"
    async
  ></script>
</section>
