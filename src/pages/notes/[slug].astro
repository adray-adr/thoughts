---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import Giscus from '../../components/Giscus.astro';

export async function getStaticPaths() {
  const notes = await getCollection('notes');
  return notes.map((note) => ({
    params: { slug: note.slug },
    props: { note },
  }));
}

const { note } = Astro.props;
const { Content } = await note.render();
const formatted = note.data.date.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' });
---
<Base title={`Note — ${formatted}`}>
  <div class="note" style="border-left-width: 3px;">
    <div class="entry-date">{formatted}</div>
    <Content />
    {note.data.tags && note.data.tags.length > 0 && (
      <div class="tags">
        {note.data.tags.map((t: string) => <a class="tag" href={`/?tag=${t}`}>{t}</a>)}
      </div>
    )}
  </div>
  <Giscus />
</Base>
